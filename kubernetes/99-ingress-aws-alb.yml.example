# Access to the load balancers created by this manifest is restricted to the
# networks listed in the following variables (comma-separated IPv4 CIDRs,
# substituted by envsubst):
#
#   MALCOLM_CLIENT_CIDRS - networks of users who connect to Malcolm's web
#                          interface (443/tcp) and OpenSearch API (9200/tcp)
#   MALCOLM_SENSOR_CIDRS - networks of Hedgehog Linux sensors and other remote
#                          log forwarders, which reach Malcolm's web interface
#                          (443/tcp), OpenSearch (9200/tcp), Logstash (5044/tcp)
#                          and the JSON-over-TCP listener (5045/tcp)
#
# Both variables must be set to non-empty values before applying this manifest.
# The lists below are written so that unset variables render as invalid YAML
# and kubectl refuses the whole manifest, rather than creating load balancers
# that the AWS Load Balancer Controller would leave open to 0.0.0.0/0.
# See docs/aws.md.
---
apiVersion: v1
kind: Service
metadata:
  name: malcolm-alb-nginx-proxy
  namespace: malcolm
  annotations:
    service.beta.kubernetes.io/aws-load-balancer-type: "external"
    service.beta.kubernetes.io/aws-load-balancer-scheme: "internet-facing"
    service.beta.kubernetes.io/aws-load-balancer-target-group-attributes: "preserve_client_ip.enabled=true"
spec:
  type: LoadBalancer
  loadBalancerSourceRanges: [${MALCOLM_CLIENT_CIDRS}, ${MALCOLM_SENSOR_CIDRS}]
  selector:
    app: nginx-proxy
  ports:
    - port: 443
      protocol: TCP
      name: https
    - port: 8443
      protocol: TCP
      name: http
    - port: 9200
      protocol: TCP
      name: opensearch
---
apiVersion: v1
kind: Service
metadata:
  name: malcolm-nlb-logstash
  namespace: malcolm
  annotations:
    service.beta.kubernetes.io/aws-load-balancer-type: "nlb"
    service.beta.kubernetes.io/aws-load-balancer-scheme: "internet-facing"
    service.beta.kubernetes.io/aws-load-balancer-nlb-target-type: "ip"
    service.beta.kubernetes.io/aws-load-balancer-manage-backend-security-group-rules: "true"
    # client IP preservation is required for loadBalancerSourceRanges to be enforced on NLBs with "ip" targets
    service.beta.kubernetes.io/aws-load-balancer-target-group-attributes: "preserve_client_ip.enabled=true"
spec:
  type: LoadBalancer
  # trailing comma is intentional: an unset MALCOLM_SENSOR_CIDRS renders invalid YAML ("[,]") so kubectl refuses to apply instead of creating an unrestricted listener
  loadBalancerSourceRanges: [${MALCOLM_SENSOR_CIDRS},]
  selector:
    app: logstash
  ports:
    - port: 5044
      targetPort: 5044
      protocol: TCP
---
apiVersion: v1
kind: Service
metadata:
  name: malcolm-nlb-tcp-json
  namespace: malcolm
  annotations:
    service.beta.kubernetes.io/aws-load-balancer-type: "nlb"
    service.beta.kubernetes.io/aws-load-balancer-scheme: "internet-facing"
    service.beta.kubernetes.io/aws-load-balancer-nlb-target-type: "ip"
    service.beta.kubernetes.io/aws-load-balancer-manage-backend-security-group-rules: "true"
    # client IP preservation is required for loadBalancerSourceRanges to be enforced on NLBs with "ip" targets
    service.beta.kubernetes.io/aws-load-balancer-target-group-attributes: "preserve_client_ip.enabled=true"
spec:
  type: LoadBalancer
  # trailing comma is intentional: an unset MALCOLM_SENSOR_CIDRS renders invalid YAML ("[,]") so kubectl refuses to apply instead of creating an unrestricted listener
  loadBalancerSourceRanges: [${MALCOLM_SENSOR_CIDRS},]
  selector:
    app: filebeat
  ports:
    - port: 5045
      targetPort: 5045
      protocol: TCP
