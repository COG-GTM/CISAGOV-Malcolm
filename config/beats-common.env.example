# Whether or not Logstash will use require encrypted communications for any external
#   Beats-based forwarders from which it will accept logs
BEATS_SSL=true
# When BEATS_SSL is true, whether Logstash requires external Beats-based forwarders to present
#   a client certificate signed by Malcolm's CA (see ./scripts/auth_setup): "required" or "optional"
BEATS_SSL_CLIENT_AUTHENTICATION=required
# host:port for connecting to Logstash instance. When using Malcolm's internal instance
#   of Logstash this should be logstash:5044
LOGSTASH_HOST=logstash:5044